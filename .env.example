# Supabase (optional). If not set, the app runs in "Local Demo Mode"
# with auth + progress persisted in localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (optional). Without these, "Hazte Premium" falls back to a local demo
# unlock. With them, /api/checkout opens a real Stripe Checkout session.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# "subscription" (recurring price) or "payment" (one-time). Default: subscription
STRIPE_MODE=subscription
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
